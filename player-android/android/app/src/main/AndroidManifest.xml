<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Required for all network calls (API, streaming). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional SSID routing; location is requested only by Use current Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android's playback Visualizer requires this; requested only when
         the user enables music visuals. We never open the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Required by audio_service to keep audio playing when the app is in the
         background.  Without this the OS may kill the media playback process. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required to declare mediaPlayback foreground service type on API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Prevents the CPU from sleeping while audio is actively playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <queries>
        <!-- Allows production-certificate validation on Android 11+. -->
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:label="Player"
        android:name="${applicationName}"
        android:icon="@drawable/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The build's PLAYER_BASE_URL supplies this scheme, host, and port.
                 A wildcard host would claim unrelated sites. Android cannot
                 update an intent-filter when the in-app server setting changes.
                 The server issues 16-byte tokens as 32 hex characters; the
                 fixed-length pattern excludes /s/{token}/stream and /download. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${playerShareScheme}"
                      android:host="${playerShareHost}"
                      android:port="${playerSharePort}"
                      android:pathPattern="/s/................................" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShareLinkMismatchActivity"
            android:exported="false"
            android:theme="@style/NormalTheme" />
        <activity android:name=".MusicAutomationActivity" android:exported="true"
            android:label="Player music" android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        <receiver android:name=".MusicAutomationReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Android Auto (phone projection) discovers media via this name. -->
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Android Automotive OS car.media requires this separate opt-in;
             without it MediaSource skips the browse service as a
             "non media template app". -->
        <meta-data android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />
        <!-- Disable Impeller on the x86_64 emulator: its OpenGL ES driver
             does not support GL_EXT_shader_framebuffer_fetch, causing Impeller
             to fail compiling blend-mode shaders.  Skia renders correctly. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <service android:name=".AutomaticMusicJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- audio_service background playback service.
             android:foregroundServiceType="mediaPlayback" is mandatory on
             Android 10+ (API 29+) to grant media-playback foreground service
             privileges.  This overrides the entry auto-merged from
             audio_service's own manifest to explicitly pin the foreground
             service type.  Class names match audio_service 0.18.x internals. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The only public browse endpoint validates callers and forwards the
             existing audio_service session token, never a second player. -->
        <service android:name=".AutoBrowseService" android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- AAOS car.media lists only MBS components with this flag (or
                 launcher-less "legacy" media apps). Without it, MediaSource
                 skips Player as a non media template app even when
                 com.android.automotive application meta-data is present. -->
            <meta-data android:name="androidx.car.app.launchable"
                android:value="true" />
        </service>
        <receiver android:name=".PlaybackWidgetProvider" android:exported="false"
            android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/playback_widget_info" />
        </receiver>
        <!-- Receives hardware media button events (headset play/pause, etc.)
             and forwards them to audio_service. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
